# ─────────────────────────────────────────────────
# LeadHunter — Environment Variables
# Copy this file to .env.local and fill in your keys
# ─────────────────────────────────────────────────

# Google Places API Key
# Required for real business search
# Get it at: https://console.cloud.google.com/apis/library/places-backend.googleapis.com
# Enable: Places API (New) or Places API
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Google PageSpeed Insights API Key (optional — uses same key as Places by default)
# Enable: PageSpeed Insights API
# Fallback: uses GOOGLE_PLACES_API_KEY if not set
GOOGLE_PAGESPEED_API_KEY=your_pagespeed_api_key_here

# ─────────────────────────────────────────────────
# DEMO MODE (no keys needed)
# ─────────────────────────────────────────────────
# Click the "DEMO" toggle in the UI to use mock data
# without any API keys configured.
